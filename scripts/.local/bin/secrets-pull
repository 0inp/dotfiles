#!/bin/bash
# Pull secrets from the Bitwarden vault (source of truth) into the macOS
# keychain (the fast local cache that fnox reads on every shell).
#
# Why this exists rather than `fnox sync`:
#   fnox sync only targets *encryption* providers (age, KMS). The keychain is a
#   local storage provider and is rejected as a sync target, so the pull is done
#   here instead.
#
# Why Bitwarden is not wired into shell startup:
#   `bw` costs ~1.2s per call, needs a master-password unlock, and — per
#   `bw unlock --help` — "after unlocking, any previous session keys will no
#   longer be valid", so one unlock invalidates every other tab and agent.
#   The vault is therefore pulled from explicitly, by you, when you choose.
#
# Usage:
#   secrets-pull            pull every secret listed below
#   secrets-pull -n         dry run: report what would change, write nothing
set -euo pipefail

# ENV_VAR_NAME:Bitwarden item name
# Item names must be unique in the vault — `bw get` fails on ambiguous matches.
SECRETS=(
  "GITHUB_PERSONAL_ACCESS_TOKEN:GITHUB_PERSONAL_ACCESS_TOKEN"
  "LINEAR_API_KEY:LINEAR_API_KEY"
)

DRY_RUN=0
[[ "${1:-}" == "-n" || "${1:-}" == "--dry-run" ]] && DRY_RUN=1

command -v bw   >/dev/null || { echo "❌ bw not found (brew install bitwarden-cli)" >&2; exit 1; }
command -v fnox >/dev/null || { echo "❌ fnox not found (brew install fnox)" >&2; exit 1; }

# ---------- authenticate ----------
status="$(bw status 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["status"])' 2>/dev/null || echo unknown)"

case "$status" in
  unauthenticated)
    echo "❌ Bitwarden is not logged in. Run: bw login" >&2
    exit 1
    ;;
  locked)
    echo "🔓 Vault is locked — unlocking (this invalidates other bw sessions)."
    BW_SESSION="$(bw unlock --raw)" || { echo "❌ unlock failed" >&2; exit 1; }
    export BW_SESSION
    ;;
  unlocked) : ;;
  *)
    echo "❌ Could not determine Bitwarden status (got: $status)" >&2
    exit 1
    ;;
esac

echo "🔄 Syncing vault from server..."
bw sync >/dev/null || echo "⚠️  bw sync failed; using local vault cache" >&2

# ---------- fetch everything first ----------
# Nothing is written to the keychain until every value is fetched and validated,
# so a failure halfway through cannot leave the keychain half-updated.
declare -a keys=() vals=()
failed=0

for entry in "${SECRETS[@]}"; do
  key="${entry%%:*}"
  item="${entry#*:}"
  if ! value="$(bw get password "$item" 2>/dev/null)"; then
    echo "❌ $key — no Bitwarden item named '$item' (or multiple matched)" >&2
    failed=1
    continue
  fi
  if [[ -z "$value" ]]; then
    echo "❌ $key — item '$item' has an empty password field" >&2
    failed=1
    continue
  fi
  keys+=("$key")
  vals+=("$value")
done

if (( failed )); then
  echo "❌ Aborting without writing anything. Fix the items above and re-run." >&2
  exit 1
fi

# ---------- write ----------
for i in "${!keys[@]}"; do
  key="${keys[$i]}"
  new="${vals[$i]}"
  old="$(fnox get "$key" 2>/dev/null || true)"
  short="$(printf '%s' "$new" | shasum -a 256 | cut -c1-12)"

  if [[ "$old" == "$new" ]]; then
    echo "✓ $key unchanged ($short)"
    continue
  fi

  if (( DRY_RUN )); then
    echo "→ $key WOULD update to $short"
  else
    printf '%s' "$new" | fnox set -g "$key" -p keychain >/dev/null
    echo "✓ $key updated to $short"
  fi
done

(( DRY_RUN )) && echo "🔍 Dry run — nothing written." || echo "🎉 Keychain is up to date."
