# vim:ft=gitconfig
[alias]
  co = checkout
  commend = commit --amend --no-edit
  s = status -sb
  d = diff -w
  unshallow = "! git remote set-branches origin '*' && git pull --unshallow"
  edit-changes = "!nvim $(git diff --name-only --diff-filter=M) -O"
  fco = "!git checkout $(git branch -a | fzf)"
  grog = log --graph --abbrev-commit --decorate --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(dim white) - %an%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n %C(white)%s%C(reset)'
  it = "!git init && git commit -m 'Initial commit' --allow-empty"
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit -10
  purr = pull --rebase
  ready = rebase -i @{u}
  sweep = "!git remote update -p && git purr && git branch --merged | grep -Ev '^\\*|master|main' | xargs -I{} git branch -d {}"
  wync = "!git stash && git purr && git stash pop && git push"
  cwip = "!git add . && git commit --no-verify -m 'WIP'"

[branch]
  # Most-recently-committed-to first; far more useful than alphabetical once a
  # repo has more than a handful of branches.
  sort = -committerdate

[color]
  ui = true

[column]
  # Multi-column output for `git branch`, `git tag`, `git status` when it fits.
  ui = auto

[commit]
	gpgsign = true

[core]
  editor = nvim
  # Builtin FSMonitor daemon + untracked cache: `git status` stops stat()-ing
  # the whole worktree on large repos. Verified working on macOS with
  # `git fsmonitor--daemon status` and `git update-index --test-untracked-cache`.
  fsmonitor = true
  untrackedCache = true
  autocrlf = input
  ignorecase = false
  excludesfile = ~/.gitignore
  pager = "delta"

[delta]
  features = decorations
  navigate = true
  light = false
  minus-style                   = bold red
  minus-non-emph-style          = bold red
  minus-emph-style              = bold reverse red
  minus-empty-line-marker-style = normal "#3f0001"
  plus-style                    = bold green
  plus-non-emph-style           = bold green
  plus-emph-style               = bold reverse green

[diff]
  algorithm = histogram

[delta "interactive"]
  keep-plus-minus-markers = false

[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow ul
  file-decoration-style = none
  hunk-header-decoration-style = cyan box ul

[fetch]
  prune = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = "~/.ssh/allowed_signers"

[http]
  sslVerify = true

[init]
  defaultBranch = main

[interactive]
  diffFilter = "delta --color-only --features=interactive"

[log]
  abbrevCommit = true

[merge]
  tool = nvimdiff
  conflictStyle = zdiff3

[pull]
  rebase = merges

[push]
  default = current
  # `git push` on a brand-new branch now sets the upstream itself, which is
  # what the removed `upush` alias used to do by hand.
  autoSetupRemote = true

[rebase]
  autosquash = true

[rerere]
  enabled = true
  autoupdate = true

[user]
	signingkey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ6bYKA/jEjXIWVgUY+tMO6Nqv0EAN2LsRwR+FpxLKk5 point-stephane@proton.me"
  name = "Stephane Point"
  email = point-stephane@proton.me

[tag]
	gpgSign = true
