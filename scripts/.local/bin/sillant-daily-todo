#!/bin/bash
# Turn the current git and Linear state into a todo.txt block that tuxedo reads.
#
# The ticket is the todo.txt +project, written right after the priority, so it
# is both what `tuxedo lsprj` groups by and the first thing the line says. The
# repo gets no tag: the PR reference in the action already names it.
#
# Generated tasks carry gen:<date>. Each run deletes the incomplete tagged ones
# and writes a fresh block, so re-running it is idempotent. Completed tasks are
# left alone, and removing a task's gen: tag hands it to you for good.
#
# Usage:
#   sillant-daily-todo        regenerate today's block
#   sillant-daily-todo -n     dry run: print what would be written
set -euo pipefail

# The repos to look at. This is the one thing to edit.
REPOS=(
  "$HOME/dev/sillant/Table"
  "$HOME/dev/sillant/vicat"
  "$HOME/dotfiles"
)

# Past ~8 the list stops being read in the morning.
MAX_TASKS=8

DRY_RUN=0
[[ "${1:-}" == "-n" || "${1:-}" == "--dry-run" ]] && DRY_RUN=1

for tool in claude tuxedo wt git; do
  command -v "$tool" >/dev/null || {
    echo "❌ $tool introuvable" >&2
    exit 1
  }
done

TODO_DIR="${TODO_DIR:-$HOME/.local/share/todo}"
TODO_FILE="${TODO_FILE:-$TODO_DIR/todo.txt}"
mkdir -p "$TODO_DIR"
[[ -f "$TODO_FILE" ]] || : >"$TODO_FILE"

TODAY="$(date +%F)"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
CONTEXT="$WORK/context.md"

# ---------- collect git state ----------
echo "→ collecte de l'état git…" >&2
{
  echo "# Git state on $TODAY"
  echo
  for repo in "${REPOS[@]}"; do
    # Inside a worktree .git is a file, so a directory test would skip it.
    git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || {
      echo "(skipped, not a git repo: $repo)"
      continue
    }
    echo "## $(basename "$repo")"
    echo '```'
    # One call, and the same view the human reads.
    (cd "$repo" && wt list 2>&1) || echo "(wt list failed)"
    echo '```'
    if (cd "$repo" && git remote get-url origin >/dev/null 2>&1); then
      echo "### Open PRs authored by me"
      echo '```'
      (cd "$repo" && gh pr list --author "@me" \
        --json number,title,isDraft,reviewDecision,statusCheckRollup \
        --template '{{range .}}#{{.number}} {{.title}} draft={{.isDraft}} review={{.reviewDecision}}
{{end}}' 2>&1) || echo "(gh unavailable)"
      echo '```'
    fi
    echo
  done
} >"$CONTEXT"

# ---------- ask Claude ----------
echo "→ interrogation de Claude (Linear via MCP)…" >&2
PROMPT=$(
  cat <<EOF
Voici l'état git de mes dépôts. Croise-le avec mes tickets Linear assignés et
non terminés (utilise les outils MCP Linear).

Produis AU PLUS $MAX_TASKS lignes au format todo.txt, la plus urgente d'abord.
Règles de sortie :
- Une tâche par ligne. Rien d'autre : pas de préambule, pas de numérotation,
  pas de markdown, pas de bloc de code, pas de commentaire final.
- Écris en français. Laisse tels quels les identifiants et le vocabulaire
  technique : clés Linear, références de PR (vicat#827), noms de branches, de
  fichiers et de commandes, et les @contextes ci-dessous.
- Chaque ligne : une priorité (A)-(C) facultative, puis le ticket écrit
  +DEV-1234 quand il y en a un, puis UNE action concrète, puis un @contexte
  parmi @review, @merge, @git.
- Le ticket n'apparaît qu'une fois, sous la forme +DEV-1234. Ne le répète pas
  en clair dans le texte de l'action.
- N'ajoute pas de +projet pour le dépôt : il se lit déjà dans la référence de
  PR que porte l'action.
- L'action doit être démarrable immédiatement. « Continuer DEV-1234 » ne sert à
  rien ; « rebaser sur main, 7 commits de retard » oui.
- Préfère ce qui est bloqué, en attente de moi ou à l'arrêt, à ce qui est
  seulement ouvert.
- Si rien ne vaut la peine dans un dépôt, n'écris aucune ligne pour lui.

Exemple de la forme attendue :
(A) +DEV-1937 pousser .worktrees/dev-1937, 4 commits non poussés @git
(B) +DEV-1583 répondre à la revue sur Table#1119 @review

État git :

$(cat "$CONTEXT")
EOF
)

set +e
# Linear is the only allowed tool, so the brief cannot touch a file.
RAW="$(claude -p "$PROMPT" \
  --allowed-tools "mcp__plugin_linear_linear" 2>"$WORK/err")"
rc=$?
set -e
if [[ $rc -ne 0 ]]; then
  echo "❌ claude a échoué (code $rc)" >&2
  sed 's/^/   /' "$WORK/err" >&2
  exit 1
fi

# ---------- keep only plausible todo.txt lines ----------
# The model is told not to editorialise; this drops a stray line if it does.
# A read loop rather than mapfile, which /bin/bash 3.2 on macOS lacks.
TASKS=()
while IFS= read -r line; do
  TASKS+=("$line")
done < <(
  printf '%s\n' "$RAW" \
    | sed 's/[[:space:]]*$//' \
    | grep -v '^[[:space:]]*$' \
    | grep -v '^[[:space:]]*```' \
    | grep -v '^[[:space:]]*#' \
    | grep -vE '^[[:space:]]*[-*][[:space:]]' \
    | head -n "$MAX_TASKS"
)

if [[ ${#TASKS[@]} -eq 0 ]]; then
  echo "⚠️  Claude n'a renvoyé aucune ligne exploitable ; $TODO_FILE inchangé." >&2
  exit 0
fi

# ---------- rewrite the generated block, atomically ----------
NEW="$WORK/todo.txt"
# Any day's tag, so yesterday's leftovers do not pile up under today's.
# Interval syntax like {4} is spelled out; awk implementations differ on it.
awk '
  {
    done = ($0 ~ /^[ \t]*x[ \t]/)
    gen  = ($0 ~ /(^|[ \t])gen:[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]([ \t]|$)/)
    if (!done && gen) next
    print
  }
' "$TODO_FILE" >"$NEW"

for task in "${TASKS[@]}"; do
  printf '%s gen:%s\n' "$task" "$TODAY" >>"$NEW"
done

if [[ $DRY_RUN -eq 1 ]]; then
  echo "— essai à blanc, $TODO_FILE inchangé. Écrirait :"
  cat "$NEW"
  exit 0
fi

# tuxedo reloads on external change, so an open TUI picks this up by itself.
cp "$TODO_FILE" "$TODO_FILE.bak"
mv "$NEW" "$TODO_FILE"

echo "✅ ${#TASKS[@]} tâches écrites dans $TODO_FILE (copie précédente : $TODO_FILE.bak)"
tuxedo ls
