theme = Gruvbox Dark
background-opacity = 0.95
# Liquid Glass (macOS 26+): the system material, which tints and reacts to what
# is behind the window, instead of a plain gaussian blur. Was a radius of 25.
background-blur = macos-glass-regular

font-family = JetBrainsMonoNL Nerd Font
font-feature = -liga,-calt,-dlig
cursor-style = block
cursor-style-blink = false
cursor-color = cell-foreground
cursor-text = cell-background

macos-titlebar-style = hidden
macos-option-as-alt = true
mouse-hide-while-typing = true

confirm-close-surface = false
window-decoration = auto
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true

auto-update = check
auto-update-channel = stable

# extras
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
copy-on-select = clipboard
