# vim:ft=gitconfig
[alias]
  co = checkout
  commend = commit --amend --no-edit
  s = status -sb
  d = diff -w
  unshallow = "! git remote set-branches origin '*' && git pull --unshallow"
  edit-changes = "!nvim $(git diff --name-only --diff-filter=M) -O"
  # for-each-ref, not `git branch -a`: its "* " marker was glob-expanded by sh
  # into file names, and `git checkout <files> main` reset those files.
  fco = "!git for-each-ref --format='%(refname:lstrip=2)' refs/heads refs/remotes/origin | sed 's#^origin/##' | grep -vx HEAD | sort -u | fzf | xargs git switch"
  grog = log --graph --abbrev-commit --decorate --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(dim white) - %an%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n %C(white)%s%C(reset)'
  it = "!git init && git commit -m 'Initial commit' --allow-empty"
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' -10
  ready = rebase -i @{u}
  # Removes worktrees and branches already in the default branch, squash merges
  # included; never the main worktree nor one with uncommitted changes.
  # `git sweep --dry-run` previews.
  sweep = "!wt step prune"
  # --autostash, not stash/pop: with nothing to stash, `stash pop` applied an old,
  # unrelated stash.
  wync = "!git pull --autostash && git push"
  cwip = "!git add . && git commit --no-verify -m 'WIP'"
  # git history (2.54+, experimental): fix or reword any commit without an
  # interactive rebase; branches built on top are rewritten along. No hooks run.
  fixup = history fixup
  reword = history reword

[branch]
  # Most-recently-committed-to first; far more useful than alphabetical once a
  # repo has more than a handful of branches.
  sort = -committerdate

[column]
  # Multi-column output for `git branch`, `git tag`, `git status` when it fits.
  ui = auto

[commit]
	gpgsign = true

[core]
  editor = nvim
  # Builtin FSMonitor daemon + untracked cache: `git status` stops stat()-ing
  # the whole worktree on large repos. Verified working on macOS with
  # `git fsmonitor--daemon status` and `git update-index --test-untracked-cache`.
  fsmonitor = true
  untrackedCache = true
  autocrlf = input
  excludesfile = ~/.gitignore
  pager = "delta"

[delta]
  features = decorations
  navigate = true
  light = false
  # bat's built-in Catppuccin Mocha, like bat itself (bat module).
  syntax-theme = Catppuccin Mocha
  minus-style                   = bold red
  minus-non-emph-style          = bold red
  minus-emph-style              = bold reverse red
  minus-empty-line-marker-style = normal "#4a2e3d"
  plus-style                    = bold green
  plus-non-emph-style           = bold green
  plus-emph-style               = bold reverse green

[diff]
  algorithm = histogram

[delta "interactive"]
  keep-plus-minus-markers = false

[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow ul
  file-decoration-style = none
  hunk-header-decoration-style = cyan box ul

[fetch]
  prune = true
  # Keep origin/HEAD on the remote's current default branch, so scripts can ask
  # for it (`git rev-parse --abbrev-ref origin/HEAD`) instead of assuming main.
  followRemoteHEAD = always

# Declared in config (git 2.54+), so it runs in EVERY repo, before the repo's
# own .git/hooks/pre-commit (lefthook, pre-commit). The dotfiles repo turns it
# off locally because lefthook already runs the same scan there.
[hook "gitleaks"]
  event = pre-commit
  command = gitleaks git --staged --redact --no-banner

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = "~/.ssh/allowed_signers"

[init]
  defaultBranch = main

[interactive]
  diffFilter = "delta --color-only --features=interactive"

[log]
  abbrevCommit = true

[merge]
  tool = nvimdiff
  conflictStyle = zdiff3

[pull]
  rebase = merges

[push]
  default = current
  # `git push` on a brand-new branch now sets the upstream itself, which is
  # what the removed `upush` alias used to do by hand.
  autoSetupRemote = true

[status]
  # A branch cut from origin/main tracks it but pushes to origin/<branch>
  # (push.default = current): show how far it is from both.
  compareBranches = @{upstream} @{push}

[rebase]
  autosquash = true

[rerere]
  enabled = true
  autoupdate = true

[user]
	signingkey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ6bYKA/jEjXIWVgUY+tMO6Nqv0EAN2LsRwR+FpxLKk5 point-stephane@proton.me"
  name = "Stephane Point"
  email = point-stephane@proton.me

[tag]
	gpgSign = true

# Work identity for Sillant repos; must stay last so it overrides [user] above.
[includeIf "gitdir:~/dev/sillant/"]
  path = ~/.gitconfig-sillant
