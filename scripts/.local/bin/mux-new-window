#!/usr/bin/env bash
# Usage: mux-new-window <name> <command>
# Opens a new window/tab in herdr or tmux, depending on the active multiplexer.
name="$1"
cmd="$2"

if [ -n "${HERDR_ENV}" ]; then
  pane_id=$(herdr tab create --label "$name" --focus | python3 -c "import sys,json; d=json.load(sys.stdin); print(d['result']['root_pane']['pane_id'])")
  herdr pane run "$pane_id" "$cmd"
elif [ -n "${TMUX}" ]; then
  tmux new-window -n "$name" "$cmd"
else
  bash -c "$cmd"
fi
