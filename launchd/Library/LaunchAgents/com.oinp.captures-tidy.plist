<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Renames every capture in ~/Pictures/Screenshots and shrinks the oversized
  recordings. See scripts/.local/bin/captures-tidy.

  WatchPaths, not a resident fswatch process: launchd watches the folder with
  kqueue and starts the job when its contents change, so there is nothing to
  keep alive and nothing to restart after a crash. It also drops the fswatch
  Homebrew dependency the deleted com.oinp.screenshots-to-mp4 agent needed.

  The two absolute /Users/oinp paths below are unavoidable: launchd performs no
  tilde or variable expansion in WatchPaths or StandardOutPath. ProgramArguments
  goes through bash so that one at least can use $HOME.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.oinp.captures-tidy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec "$HOME/.local/bin/captures-tidy"</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>/Users/oinp/Pictures/Screenshots</string>
    </array>

    <!-- Catches anything that landed while logged out. The scan is idempotent. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Tunables. Changing one here beats editing the script; reload after. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>TARGET_MB</key>
        <string>20</string>
        <key>MAX_LONG_EDGE</key>
        <string>1440</string>
        <!--
          20, not 25. The source is 60fps, and 60/20 = 3 exactly, so every
          third frame is kept and the cadence stays even. 60/25 = 2.4 drops in
          an uneven 2,2,3,2,3 pattern, which reads as judder on smooth
          scrolling. 30 is also clean (60/2) but costs more time.
        -->
        <key>FPS_CAP</key>
        <string>20</string>
        <key>X265_PRESET</key>
        <string>veryfast</string>
    </dict>

    <!--
      Interactive, and this is the single highest-impact key in the file.

      On Apple Silicon ProcessType decides which CPU cluster the job may run
      on, and it has no gradual middle: Background and Standard both confine it
      to the efficiency cores, Interactive lets it use everything. Measured on
      the same 5-minute recording, same script, same file:

        Background    ~250% CPU    474s
        Standard       552% CPU    231s   (552% is the 6 E-cores saturated)
        Interactive    792% CPU    105s
        foreground     771% CPU    111s   (reference)

      `nice` is a red herring. It reads 19 in every one of those rows — even
      Interactive at 792% — so the nice value is not what gates core access,
      the QoS class is. The Nice key was tried at 10 and removed again: 234s
      with it, 231s without. It does nothing here, which is why it is absent.
      A process cannot fix this from the inside either, since lowering its own
      niceness needs privilege.

      The cost of Interactive is real: ~790% CPU for the ~2 minutes after each
      save. Chosen deliberately over Standard's invisible-but-4-minute encode.
    -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/tmp/captures-tidy.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/captures-tidy.error.log</string>
</dict>
</plist>
