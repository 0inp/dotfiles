theme = Catppuccin Mocha
background-opacity = 0.95
# A plain gaussian blur. Tried and rejected: macos-glass-regular (Liquid Glass).
background-blur = 25

# Not a Nerd Font patch: Ghostty embeds Symbols Nerd Font, so eza, nvim and
# lazygit icons render with any font.
font-family = Monaspace Neon
# Ligatures off, `calt` ON: Monaspace's texture healing (wider m/w next to
# narrow letters) is a contextual alternate and dies with -calt.
font-feature = -liga,-dlig
cursor-style = block
cursor-style-blink = false
cursor-color = cell-foreground
cursor-text = cell-background

macos-titlebar-style = hidden
macos-option-as-alt = true
mouse-hide-while-typing = true

confirm-close-surface = false
window-decoration = auto
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true

auto-update = check
auto-update-channel = stable

# extras
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
copy-on-select = clipboard
